@WebAPI_HostAddress = http://localhost:5186
@studentId = 11111111-1111-4111-8111-111111111111
@databaseCourseId = aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa2
@webApiCourseId = aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaa3

# OpenAPI document
GET {{WebAPI_HostAddress}}/openapi/v1.json
Accept: application/json

###

# OpenAPI document for v2
GET {{WebAPI_HostAddress}}/openapi/v2.json
Accept: application/json

###

# List students
GET {{WebAPI_HostAddress}}/api/v1/students?page=1&pageSize=20
Accept: application/json

###

# Get a student by ID
GET {{WebAPI_HostAddress}}/api/v1/students/{{studentId}}
Accept: application/json

###

# List courses
GET {{WebAPI_HostAddress}}/api/v1/courses?page=1&pageSize=20
Accept: application/json

###

# Get a course by ID
GET {{WebAPI_HostAddress}}/api/v1/courses/{{databaseCourseId}}
Accept: application/json

###

# Create a student
POST {{WebAPI_HostAddress}}/api/v1/students
Idempotency-Key: 7fba074d-760a-42db-a208-ccff8d703ac3
Content-Type: application/json

{
  "fullName": "Layla Hassan"
}

###

# Create a course with twelve seats
POST {{WebAPI_HostAddress}}/api/v1/courses
Idempotency-Key: 4afb4ad7-08c8-48ed-90cc-6a44fbdbeafb
Content-Type: application/json

{
  "title": "Software Design",
  "capacity": 12
}

###

# Enroll in Database Fundamentals (expected HTTP 204)
POST {{WebAPI_HostAddress}}/api/v1/students/{{studentId}}/enrollments
Idempotency-Key: 9b05581e-af9e-45a4-a15f-8b3fd93f5519
Content-Type: application/json

{
  "courseId": "{{databaseCourseId}}"
}

###

# Enroll in ASP.NET Core Web API (expected HTTP 204)
POST {{WebAPI_HostAddress}}/api/v1/students/{{studentId}}/enrollments
Idempotency-Key: a11ed8f3-c22b-40b5-ad8b-826f242b3553
Content-Type: application/json

{
  "courseId": "{{webApiCourseId}}"
}

###

# List courses a student is enrolled in (includes the seeded enrollment)
GET {{WebAPI_HostAddress}}/api/v1/students/{{studentId}}/courses
Accept: application/json

###

# Repeat enrollment in Database Fundamentals (expected HTTP 409)
POST {{WebAPI_HostAddress}}/api/v1/students/{{studentId}}/enrollments
Idempotency-Key: 64d91545-93e8-4e58-8227-bfb66fa30eb0
Content-Type: application/json

{
  "courseId": "{{databaseCourseId}}"
}

###

# Get the Database Fundamentals enrollment
GET {{WebAPI_HostAddress}}/api/v1/students/{{studentId}}/enrollments/{{databaseCourseId}}
Accept: application/json

###

# Cancel the Database Fundamentals enrollment and release the seat (expected HTTP 204)
DELETE {{WebAPI_HostAddress}}/api/v1/students/{{studentId}}/enrollments/{{databaseCourseId}}

###

# Get the canceled enrollment (expected HTTP 404)
GET {{WebAPI_HostAddress}}/api/v1/students/{{studentId}}/enrollments/{{databaseCourseId}}
Accept: application/json

###

# Check API and SQLite readiness
GET {{WebAPI_HostAddress}}/health

###

# ---------- External API (JSONPlaceholder) ----------

# List external users, page 1 of 5 (expected HTTP 200, totalCount 10)
GET {{WebAPI_HostAddress}}/api/v1/jsonplaceholder/users?page=1&pageSize=5
Accept: application/json

###

# Get external user 1 (expected HTTP 200)
GET {{WebAPI_HostAddress}}/api/v1/jsonplaceholder/users/1
Accept: application/json

###

# Get a missing external user (expected HTTP 404, JsonPlaceholder.UserNotFound)
GET {{WebAPI_HostAddress}}/api/v1/jsonplaceholder/users/999
Accept: application/json

###

# Invalid external user id (expected HTTP 400)
GET {{WebAPI_HostAddress}}/api/v1/jsonplaceholder/users/0
Accept: application/json

###

# Create an external post (expected HTTP 201, id 101; JSONPlaceholder does not persist it)
POST {{WebAPI_HostAddress}}/api/v1/jsonplaceholder/posts
Idempotency-Key: fae030b6-5584-4769-aa08-80f1b6db412f
Content-Type: application/json

{
  "userId": 1,
  "title": "Hello from the template",
  "body": "Created through IJsonPlaceholderClient."
}

###

# Create an external post with an empty title (expected HTTP 400)
POST {{WebAPI_HostAddress}}/api/v1/jsonplaceholder/posts
Idempotency-Key: d08bcb7b-15fa-46f3-91ee-04f0ec801c13
Content-Type: application/json

{
  "userId": 1,
  "title": "",
  "body": "Missing title."
}
###

# ---------- API versioning ----------

# Courses v2: get a course with availableSeats (expected HTTP 200)
GET {{WebAPI_HostAddress}}/api/v2/courses/{{databaseCourseId}}
Accept: application/json

###

# Courses v1 is deprecated: same request on v1 (expected HTTP 200, header api-deprecated-versions: 1.0)
GET {{WebAPI_HostAddress}}/api/v1/courses/{{databaseCourseId}}
Accept: application/json

###

# Create a course through v2 (expected HTTP 201, Location points to /api/v2/courses/{id})
POST {{WebAPI_HostAddress}}/api/v2/courses
Idempotency-Key: 2ce93c26-2503-48ef-98cb-5e6c486d929e
Content-Type: application/json

{
  "title": "Clean Architecture",
  "capacity": 20
}

###

# Unsupported version: students have no v2 (expected HTTP 404 with a ProblemDetails body)
GET {{WebAPI_HostAddress}}/api/v2/students
Accept: application/json
###

# ---------- Idempotency ----------
# Every POST requires an Idempotency-Key header. Send the same request again with the same key:
# the first response is returned again (header Idempotency-Replayed: true) and nothing is created twice.
# Keys are kept for 24 hours (Idempotency:ExpirationHours).

# 1. Create a student with a fixed key (expected HTTP 201)
POST {{WebAPI_HostAddress}}/api/v1/students
Content-Type: application/json
Idempotency-Key: 3f2a9c1e-7b4d-4e8a-9c2f-1a5b6d7e8f90

{
  "fullName": "Idempotent Student"
}

###

# 2. Same key, same body: replayed (expected the same HTTP 201 and the same ID, Idempotency-Replayed: true)
POST {{WebAPI_HostAddress}}/api/v1/students
Content-Type: application/json
Idempotency-Key: 3f2a9c1e-7b4d-4e8a-9c2f-1a5b6d7e8f90

{
  "fullName": "Idempotent Student"
}

###

# 3. Same key, different body (expected HTTP 422, Idempotency.KeyReused)
POST {{WebAPI_HostAddress}}/api/v1/students
Content-Type: application/json
Idempotency-Key: 3f2a9c1e-7b4d-4e8a-9c2f-1a5b6d7e8f90

{
  "fullName": "Someone Else"
}

###

# 4. No key (expected HTTP 400, Idempotency.KeyMissing)
POST {{WebAPI_HostAddress}}/api/v1/students
Content-Type: application/json

{
  "fullName": "No Key"
}
